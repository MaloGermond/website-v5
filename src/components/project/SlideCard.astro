---
const { kicker, title, text } = Astro.props;
---

<div class="p-4 flex flex-col gap-2 max-w-sm">
  {
    kicker && (
      <p class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-400">
        {kicker}
      </p>
    )
  }
  <h3 class="font-avara text-lg sm:text-2xl dark:text-gray-50">{title}</h3>
  <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400">{text}</p>
</div>
