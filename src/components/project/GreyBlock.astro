---
const {
  ratio = 'aspect-video',
  label = '',
  class: classList = '',
} = Astro.props;
---

<div
  class={`w-full max-w-4xl mx-auto bg-gray-200 dark:bg-gray-800 shadow-[inset_0_0_0_1px_rgb(0_0_0_/_8%)] dark:shadow-[inset_0_0_0_1px_rgb(255_255_255_/_8%)] ${ratio} ${classList}`}
  role="img"
  aria-label={label}
>
</div>
