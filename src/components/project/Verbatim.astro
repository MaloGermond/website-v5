---
const { tag, time, text } = Astro.props;
---

<div class="p-4 bg-surface-raise border border-on-surface-default/10 shadow-sm max-w-xs">
  <span
    class="inline-block px-2 py-0.5 mb-2 text-[10px] uppercase tracking-wide text-white bg-on-surface-success rounded-full"
  >
    {tag}
  </span>
  <p class="text-sm text-on-surface-default">
    <span class="font-medium">{time}</span>
    {text}
  </p>
</div>
