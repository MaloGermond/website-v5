---
const { tag, time, text, class: classList = '' } = Astro.props;
---

<div class={`p-5 rounded-lg bg-[#f2f8f6] max-w-sm ${classList}`}>
  <span
    class="inline-block px-3 py-1 mb-2 text-xs font-medium uppercase tracking-wide text-[#1d2924] bg-[#2fc2a8] rounded-full"
  >
    {tag}
  </span>
  <p class="text-[#1d2924]">
    <span class="font-medium">User ({time})</span>
    {' '}{text}
  </p>
</div>
