---
const { tag, time, text } = Astro.props;
---

<div class="p-4 bg-white border border-[#123832]/10 shadow-sm max-w-xs">
  <span
    class="inline-block px-2 py-0.5 mb-2 text-[10px] uppercase tracking-wide text-white bg-[#2FBF8F] rounded-full"
  >
    {tag}
  </span>
  <p class="text-sm text-[#123832]">
    <span class="font-medium">{time}</span>
    {text}
  </p>
</div>
