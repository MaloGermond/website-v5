---
const { title, subtitle, href, class: classList = '' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 p-2 rounded-2xl border border-on-surface-subdue bg-surface-subdue transition-[background-color,box-shadow,border-color] duration-300 hover:border-on-surface-default hover:bg-surface-default hover:shadow-[0_1px_8px_rgba(0,0,0,0.1)] ${classList}`}
>
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-purple-100">
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-purple-600" aria-hidden="true">
      <path
        d="M2,6C2,3.79,3.79,2,6,2C8.21,2,10,3.79,10,6L10,18C10,20.21,8.21,22,6,22C3.79,22,2,20.21,2,18L2,6"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M10,8.24L13.31,4.93C14.88,3.37,17.41,3.37,18.97,4.93C20.53,6.49,20.53,9.02,18.97,10.59L9.30,20.25"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M6,22L18,22C20.21,22,22,20.21,22,18C22,15.79,20.21,14,18,14L15.5,14 M7,18C7,18.55,6.55,19,6,19C5.45,19,5,18.55,5,18C5,17.45,5.45,17,6,17C6.55,17,7,17.45,7,18L7,18"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.5"
      />
    </svg>
  </span>
  <span class="flex flex-1 flex-col">
    <span class="text-lg font-medium text-on-surface-default">{title}</span>
    <span class="text-sm font-normal text-on-surface-subdue">{subtitle}</span>
  </span>
  <span class="flex h-[34px] w-[34px] shrink-0 items-center justify-center">
    <svg viewBox="0 0 18 18" fill="none" class="h-[18px] w-[18px] text-on-surface-default" aria-hidden="true">
      <path
        d="M3.9375,14.0625L13.5,4.5"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M3.375,4.5L13.5,4.5L13.5,14.625"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</a>
