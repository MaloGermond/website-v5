---
const { quote, attribution } = Astro.props;
---

<blockquote class="relative max-w-2xl pl-8 border-l-4 border-on-surface-default">
  <span
    class="absolute -top-10 -left-4 text-[7rem] leading-none text-on-surface-default/15 select-none"
    aria-hidden="true">“</span
  >
  <p class="relative text-2xl sm:text-3xl leading-snug text-on-surface-default">
    {quote}
  </p>
  <cite class="block mt-6 text-sm not-italic text-on-surface-subdue text-right"
    >{attribution}</cite
  >
</blockquote>
