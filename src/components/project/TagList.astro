---
const { items } = Astro.props;
---

<div class="flex flex-row flex-wrap gap-2 justify-center">
  {
    Object(items).map((el) => (
      <span class="px-3 py-1 text-sm text-blue-800 bg-blue-100 border border-blue-300 dark:text-blue-100 dark:bg-blue-900 dark:border-blue-700">
        {el}
      </span>
    ))
  }
</div>
