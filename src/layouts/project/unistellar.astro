---
const { content} = Astro.props;
const { lang } = Astro.params;
import { Image } from 'astro:assets';
import Paragraph from '@components/Paragraph.astro';
import InfoColumn from '@components/project/InfoColumn.astro';
import Metrics from '@components/project/Metrics.astro';
import Mosaic from '@components/project/Mosaic.astro';
import Frame from "@components/Frame.astro"

import {loadScreensOnce} from "@utils/useScreens"

const screens = import.meta.glob("../../assets/unistellar/*{jpg,png,gif,webp}");
const metadata = await import("../../assets/unistellar/images-metadata.json");
const images = await loadScreensOnce(screens,metadata);

const mosaicScreens = Object.values(images).filter((el) =>
  el.name.startsWith('screen-')
);
---

<section class="relative bg-gray-900 overflow-hidden h-screen">
  <div
    class="absolute bottom-0 w-full h-full bg-gradient-to-t from-[#8BB0F9] from-0% via-transparent via-50% to-transparent to-100% fade-in animation-duration-2 animation-delay-2 opacity-0"
  >
  </div>
  <h1
    class="text-[10vw] font-avara w-full text-center pt-25 md:pt-40 text-gray-50 fade-in animation-duration-2 opacity-0"
  >
    {content.hero.title}
  </h1>
  <Image
    src={images['earth']}
    alt={images['earth']?.alt?.[lang]}
    class="absolute bottom-0 sm:bottom-[-60px] md:bottom-[-100px] lg:bottom-[-150px] xl:bottom-[-200px] 2xl:bottom-[-350px] left-1/2 translate-x-[-50%] translate-y-2/4 fade-in animation-duration-2 animation-delay-8 opacity-0"
    priority
  />
  <Image
    src={images['screen-unistellar-home']}
    alt={images['screen-unistellar-home']?.alt?.[lang]}
    class="absolute bottom-[-300px] left-1/2 translate-x-[-50%] w-xs fade-in animation-duration-1 animation-delay-2 opacity-0"
    priority
  />
</section>
<section class="px-8 py-16 max-w-7xl m-auto">
  <p class="text-sm px-4 mb-2 text-gray-400 dark:text-gray-400">
    {content.period}
  </p>
  <h2
    class="font-avara paragraph text-xl sm:text-4xl max-w-3xl p-4 dark:text-gray-50"
    data-reveal-lines
  >
    {content.contexte}
  </h2>
  <div class="flex flex-row flex-wrap" data-reveal-group>
    <InfoColumn title={content.roles.title} items={content.roles.items} reveal />
    <InfoColumn title={content.skills.title} items={content.skills.items} reveal />
  </div>
  <Metrics items={content.metrics} />
</section>

<Mosaic images={mosaicScreens} />

<section class="flex flex-col">
  <Paragraph
    class="flex flex-col justify-center text-md leading-8 sm:text-3xl sm:leading-12 md:text-5xl md:leading-20 max-w-6xl m-auto font-avara paragraphe p-12 text-gray-900 dark:text-gray-50"
    content={content.purpose}
    reveal
  />
</section>
<section>
  <Frame src={images['login']} alt={images['login']?.alt?.[lang]}/>
  <Frame src={images['catalog']} alt={images['catalog']?.alt?.[lang]}/>
  <Frame src={images['onboarding']} alt={images['onboarding']?.alt?.[lang]}/>
  <Frame src={images['observation']} alt={images['observation']?.alt?.[lang]}/>
  <Frame src={images['icons']} alt={images['icons']?.alt?.[lang]}/>
  <Frame src={images['illustrations']} alt={images['illustrations']?.alt?.[lang]}/>
</section>


<style>
  section {
    height: auto;
    min-height: 80svh;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitText, type TextSplit } from 'kugiri';

  gsap.registerPlugin(ScrollTrigger);

  /** @impure - restores each split's original markup, showing the text immediately */
  function skipReveal(splits: TextSplit[]): void {
    splits.forEach((split) => split.revert());
  }

  /** @impure - hides split lines, then reveals them with a staggered scroll-triggered animation */
  function animateReveal(splits: TextSplit[]): void {
    const lines = splits.flatMap((split) => split.lines);
    const masks = splits.flatMap((split) => split.masks);
    if (lines.length === 0) {
      return;
    }

    gsap.set(lines, { yPercent: 100, opacity: 0 });

    ScrollTrigger.create({
      trigger: lines[0],
      start: 'top 85%',
      once: true,
      onEnter: () =>
        gsap.to(lines, {
          yPercent: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power3.out',
          stagger: 0.08,
          onComplete: () => masks.forEach((mask) => (mask.style.clipPath = 'none')),
        }),
    });
  }

  /** @impure - splits a single text element into lines via kugiri and wires its scroll reveal */
  function setupTextReveal(target: HTMLElement, prefersReducedMotion: boolean): void {
    const split = splitText(target, { type: ['lines'], mask: 'lines' });
    prefersReducedMotion ? skipReveal([split]) : animateReveal([split]);
  }

  /** @impure - splits a group of items into lines via kugiri and reveals them together */
  function setupGroupReveal(group: Element, prefersReducedMotion: boolean): void {
    const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal-item]'));
    if (items.length === 0) {
      return;
    }

    const splits = splitText(items, { type: ['lines'], mask: 'lines' });
    prefersReducedMotion ? skipReveal(splits) : animateReveal(splits);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    document
      .querySelectorAll<HTMLElement>('[data-reveal-lines]')
      .forEach((target) => setupTextReveal(target, prefersReducedMotion));

    document
      .querySelectorAll<HTMLElement>('[data-reveal-group]')
      .forEach((group) => setupGroupReveal(group, prefersReducedMotion));
  });
</script>
