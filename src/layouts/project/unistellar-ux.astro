---
const { content } = Astro.props;
const { lang } = Astro.params;
import Quote from '@components/project/Quote.astro';
import TableOfContents from '@components/project/TableOfContents.astro';
import InternalLink from '@components/project/InternalLink.astro';
import StepReveal from '@components/project/StepReveal.astro';
import Verbatim from '@components/project/Verbatim.astro';
import ResultComparison from '@components/project/ResultComparison.astro';

import { loadScreensOnce } from '@utils/useScreens';

const screens = import.meta.glob('../../assets/unistellar/*{jpg,png,gif,webp}');
const metadata = await import('../../assets/unistellar/images-metadata.json');
const images = await loadScreensOnce(screens, metadata);

const ink = 'text-on-surface-default';
const inkMuted = 'text-on-surface-subdue';

const journeyItems = content.method.journey.map((step) => ({
  label: step.label,
  title: step.title,
  text: step.text,
  image: images[step.image]?.src,
}));

const navSections = [
  { id: 'introduction', label: content.nav[0] },
  { id: 'problem', label: content.nav[1] },
  { id: 'method', label: content.nav[2] },
  { id: 'facilitation', label: content.nav[3] },
  { id: 'learning', label: content.nav[4] },
  { id: 'results', label: content.nav[5] },
];
---

<div>
  <TableOfContents
    items={navSections}
    class="hidden lg:flex fixed left-14 top-1/2 -translate-y-1/2 z-10"
  />

  <section class="min-h-screen flex flex-col items-center justify-center px-8 py-20">
    <h1
      class={`font-avara text-4xl sm:text-5xl md:text-6xl text-center leading-[1.05] max-w-4xl whitespace-pre-line ${ink}`}
    >
      {content.hero.title}
    </h1>
    <div class="w-full max-w-6xl mt-24 flex flex-row justify-between items-end gap-8">
      <div class="flex flex-col gap-1">
        <p class={`text-xs ${ink}`}>{content.hero.client}</p>
        <div class="w-10 h-px bg-on-surface-subdue my-1"></div>
        <p class={`text-sm ${inkMuted}`}>{content.hero.app}</p>
        <p class={`text-xs ${inkMuted}`}>{content.hero.period}</p>
      </div>
      <ul class={`text-right text-xs ${inkMuted}`}>
        {content.hero.metrics.map((metric) => <li>{metric}</li>)}
      </ul>
    </div>
  </section>

  <section id="introduction" class="px-8 py-28 md:py-36">
    <div class="max-w-5xl mx-auto">
      <p class={`text-sm ${inkMuted}`}>{content.introduction.period}</p>
      <h2 class={`mt-4 max-w-[700px] font-avara text-4xl leading-tight whitespace-pre-line ${ink}`}>
        {content.introduction.headline}
      </h2>
      <div class="mt-16 max-w-[482px] flex flex-col gap-8">
        <p class={`text-[22px] leading-relaxed ${ink}`}>{content.introduction.text}</p>
        <InternalLink
          title={content.introduction.link.title}
          subtitle={content.introduction.link.subtitle}
          href={`/${lang}/unistellar`}
        />
        <p class={`text-[22px] leading-relaxed ${ink}`}>{content.introduction.quote}</p>
      </div>
    </div>
  </section>

  <section id="problem" class="px-8 py-28 md:py-36">
    <div class="max-w-5xl mx-auto">
      <Quote class="max-w-xl" text={content.problem.quote} />
      <div class="mt-16 max-w-[482px] flex flex-col gap-16">
        <div>
          <h2 class={`font-avara text-3xl whitespace-pre-line ${inkMuted}`}>
            {content.problem.heading}
          </h2>
          <p class={`mt-6 text-[22px] leading-relaxed whitespace-pre-line ${ink}`}>
            {content.problem.text1}
          </p>
        </div>
        <p class={`text-[22px] leading-relaxed ${ink}`}>{content.problem.text2}</p>
      </div>
    </div>
  </section>

  <section id="method" class="px-8 py-28 md:py-36">
    <div class="max-w-5xl mx-auto">
      <h2 class={`font-avara text-3xl whitespace-pre-line ${inkMuted}`}>{content.method.heading}</h2>
      <p class={`mt-6 max-w-[482px] text-[22px] leading-relaxed whitespace-pre-line ${ink}`}>
        {content.method.text1}
      </p>

      <StepReveal class="mt-16" items={journeyItems} />

      <div class="mt-16 flex flex-col md:flex-row gap-8 md:gap-[154px]">
        <p class={`md:w-[354px] text-lg font-light leading-relaxed whitespace-pre-line ${inkMuted}`}>
          {content.method.methodologyText}
        </p>
        <p class={`md:w-[524px] text-2xl font-medium leading-relaxed ${ink}`}>
          {content.method.reconstructedText}
        </p>
      </div>

      <div class="mt-20 columns-1 sm:columns-2 gap-6">
        {
          content.method.quotes.map((quote) => (
            <Verbatim
              tag={quote.tag}
              stage={quote.stage}
              text={quote.text}
              class="mb-6 break-inside-avoid"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="results" class="px-8 py-28 md:py-36">
    <div class="max-w-5xl mx-auto flex flex-col gap-8">
      {
        content.results.items.map((item) => (
          <ResultComparison
            beforeSrc={images[item.beforeImage]?.src}
            beforeAlt={images[item.beforeImage]?.alt?.[lang]}
            afterSrc={images[item.afterImage]?.src}
            afterAlt={images[item.afterImage]?.alt?.[lang]}
            label={item.label}
            title={item.title}
            text={item.text}
          />
        ))
      }
    </div>
  </section>
</div>
