---
const { content } = Astro.props;
const { lang } = Astro.params;
import Verbatim from '@components/project/Verbatim.astro';
import PhoneMockup from '@components/project/PhoneMockup.astro';
import manWithTelescopeRaw from '@assets/unistellar/man-with-a-telescope.svg?raw';

import { loadScreensOnce } from '@utils/useScreens';

// Inlined (not <Image>) so its stroke="currentColor" paths can pick up the
// on-surface-default text color instead of staying hardcoded black.
const manWithTelescope = manWithTelescopeRaw.replace(
  '<svg ',
  '<svg class="w-full h-auto" '
);

const screens = import.meta.glob(
  '../../assets/unistellar/*{jpg,png,gif,webp}'
);
const metadata = await import('../../assets/unistellar/images-metadata.json');
const images = await loadScreensOnce(screens, metadata);

const bg = 'bg-background';
const ink = 'text-on-surface-default';
const inkMuted = 'text-on-surface-subdue';
const inkFaint = 'text-on-surface-subdue/50';

const navSections = [
  { id: 'introduction', label: content.nav[0] },
  { id: 'problem', label: content.nav[1] },
  { id: 'method', label: content.nav[2] },
  { id: 'facilitation', label: content.nav[3] },
  { id: 'results', label: content.nav[4] },
  { id: 'learning', label: content.nav[5] },
];
---

<div class={bg}>
  <nav
    id="ux-nav"
    class="hidden lg:flex fixed left-14 top-1/2 -translate-y-1/2 z-10 flex-col gap-[8px] opacity-0 transition-opacity duration-500 pointer-events-none"
    aria-label="Sections de l'étude de cas"
  >
    {
      navSections.map((section) => (
        <a
          href={`#${section.id}`}
          data-nav-link={section.id}
          class="text-sm font-light leading-[17px] text-on-surface-subdue/50 transition-colors duration-300"
        >
          {section.label}
        </a>
      ))
    }
  </nav>

  <section
    id="introduction"
    class={`${bg} min-h-screen flex flex-col items-center justify-center px-8 py-20`}
  >
    <h1
      class={`font-avara text-4xl sm:text-5xl md:text-6xl text-center leading-[1.05] max-w-4xl ${ink}`}
    >
      {content.hero.title}
    </h1>
    <div class="w-full max-w-6xl mt-24 flex flex-row justify-between items-end gap-8">
      <div class="flex flex-col gap-1">
        <p class={`text-xs ${ink}`}>{content.hero.client}</p>
        <div class="w-10 h-px bg-on-surface-subdue my-1"></div>
        <p class={`text-sm ${inkMuted}`}>{content.hero.app}</p>
        <p class={`text-xs ${inkMuted}`}>{content.hero.period}</p>
      </div>
      <ul class={`text-right text-xs ${inkMuted}`}>
        {content.hero.metrics.map((metric) => <li>{metric}</li>)}
      </ul>
    </div>
  </section>

  <section id="problem" class={`${bg} px-8 py-28 md:py-36 lg:pl-64`}>
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkMuted}`}>
        {content.problem.context.title}
      </h2>
      <p class={`mt-8 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.problem.context.text}
      </p>
      <blockquote class="relative mt-20 max-w-xl">
        <span
          class={`block text-6xl leading-none ${inkMuted}`}
          aria-hidden="true">"</span
        >
        <p class={`-mt-8 text-3xl sm:text-4xl leading-snug ${ink}`}>
          {content.problem.context.quote}
        </p>
      </blockquote>
    </div>
  </section>

  <section class={`${bg} px-8 py-28 md:py-36 lg:pl-64`}>
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkMuted}`}>
        {content.problem.issue.title}
      </h2>
      <p class={`mt-8 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.problem.issue.text1}
      </p>
      <p class={`mt-6 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.problem.issue.text2}
      </p>
      <div class="mt-20 flex flex-row flex-wrap gap-8">
        <div class="w-[42%] sm:w-56">
          <p class={`mb-2 text-center text-xs uppercase tracking-wide ${inkMuted}`}>
            V1
          </p>
          <PhoneMockup
            src={images[content.problem.issue.beforeImage]?.src}
            alt={images[content.problem.issue.beforeImage]?.alt?.[lang]}
            overlay
            floating={false}
          />
        </div>
        <div class="w-[42%] sm:w-56">
          <p class={`mb-2 text-center text-xs uppercase tracking-wide ${inkMuted}`}>
            V2
          </p>
          <PhoneMockup
            src={images[content.problem.issue.afterImage]?.src}
            alt={images[content.problem.issue.afterImage]?.alt?.[lang]}
            overlay
            floating={false}
          />
        </div>
      </div>
    </div>
  </section>

  <section id="method" class="bg-surface-raise px-8 py-28 md:py-36 lg:pl-64">
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkFaint}`}>{content.method.title}</h2>
      <div class="mt-8 max-w-xl flex flex-col gap-6">
        {
          content.method.paragraphs.map((paragraph) => (
            <p class={`text-xl leading-relaxed ${ink}`}>{paragraph}</p>
          ))
        }
      </div>
      <div class="mt-20 flex flex-row flex-wrap gap-6">
        {
          content.method.quotes.map((quote, i) => (
            <Verbatim
              tag={quote.tag}
              time={quote.time}
              text={quote.text}
              class={i % 2 === 1 ? 'sm:mt-10' : ''}
            />
          ))
        }
      </div>

      <p class={`mt-20 max-w-xl text-xl leading-relaxed whitespace-pre-line ${ink}`}>
        {content.method.journeyIntro}
      </p>

      <div class="mt-16 flex flex-col md:flex-row items-start gap-10">
        <div
          class={`w-32 md:w-40 shrink-0 ${ink}`}
          aria-hidden="true"
          set:html={manWithTelescope}
        />
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            content.method.journey.map((step) => (
              <div>
                <span class="block text-xs font-medium uppercase tracking-wide text-blue-600 dark:text-blue-400">
                  {step.label}
                </span>
                <h3 class={`mt-2 text-lg font-medium ${ink}`}>{step.title}</h3>
                <p class={`mt-2 text-sm ${inkMuted}`}>{step.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="facilitation" class={`${bg} px-8 py-28 md:py-36 lg:pl-64`}>
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkFaint}`}>
        {content.facilitation.title}
      </h2>
      <p class={`mt-8 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.facilitation.intro}
      </p>
      <ol class="mt-4 max-w-xl list-decimal list-inside flex flex-col gap-1">
        {
          content.facilitation.steps.map((step) => (
            <li class={`text-xl leading-relaxed ${ink}`}>{step}</li>
          ))
        }
      </ol>
      <p class={`mt-6 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.facilitation.text}
      </p>
    </div>
  </section>

  <section id="results" class={`${bg} px-8 py-28 md:py-36 lg:pl-64`}>
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkFaint}`}>{content.results.title}</h2>
      <p class={`mt-8 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.results.text}
      </p>
    </div>
  </section>

  <section id="learning" class={`${bg} px-8 py-28 md:py-36 lg:pl-64`}>
    <div class="max-w-6xl m-auto">
      <h2 class={`font-avara text-3xl ${inkFaint}`}>{content.learning.title}</h2>
      <p class={`mt-8 max-w-xl text-xl leading-relaxed ${ink}`}>
        {content.learning.text}
      </p>
    </div>
  </section>
</div>

<script>
  const sectionIds = [
    'introduction',
    'problem',
    'method',
    'facilitation',
    'results',
    'learning',
  ];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  const nav = document.getElementById('ux-nav');
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')).map(
      (link) => [link.dataset.navLink, link]
    )
  );

  let activeIndex = 0;

  function updateNav() {
    if (!nav) return;
    nav.classList.toggle('opacity-0', activeIndex === 0);
    nav.classList.toggle('pointer-events-none', activeIndex === 0);
    sectionIds.forEach((id, i) => {
      const link = links.get(id);
      if (!link) return;
      link.classList.remove(
        'text-on-surface-default',
        'text-on-surface-subdue',
        'text-on-surface-subdue/50'
      );
      if (i === activeIndex) link.classList.add('text-on-surface-default');
      else if (i < activeIndex) link.classList.add('text-on-surface-subdue');
      else link.classList.add('text-on-surface-subdue/50');
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          const index = sectionIds.indexOf(id);
          if (index !== -1) activeIndex = index;
        }
      });
      updateNav();
    },
    { rootMargin: '-50% 0px -50% 0px' }
  );

  sections.forEach((section) => observer.observe(section));
  updateNav();
</script>
