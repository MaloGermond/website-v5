---
import Layout from '@layouts/Layout.astro';

import { getImage } from 'astro:assets';
import PhoneMockupPreview from '@components/PhoneMockupPreview.jsx';

import { locales } from '@locales/config.json';

import screenHome from '@assets/unistellar/screen-unistellar-home.png';
import screenCatalog from '@assets/unistellar/screen-unistellar-catalog.png';
import screenV1Observation from '@assets/unistellar/unistellar-screen-v1-observation.png';
import screenV2Observation from '@assets/unistellar/unistellar-screen-v2-observation.png';
import screenV3Home from '@assets/unistellar/screen-unistellar-v3-home.png';
import screenV3GalleryPreview from '@assets/unistellar/screen-unistellar-v3-gallery-previewPicture.png';
import screenV3GallerySelected from '@assets/unistellar/screen-unistellar-v3-gallery-selected.png';

export function getStaticPaths() {
  return locales.map((loc) => ({ params: { lang: loc } }));
}

const { lang } = Astro.params;

const homeImage = await getImage({ src: screenHome, width: 800 });
const catalogImage = await getImage({ src: screenCatalog, width: 800 });
const observationV1Image = await getImage({ src: screenV1Observation, width: 800 });
const observationV2Image = await getImage({ src: screenV2Observation, width: 800 });
const v3HomeImage = await getImage({ src: screenV3Home, width: 800 });
const v3GalleryPreviewImage = await getImage({ src: screenV3GalleryPreview, width: 800 });
const v3GallerySelectedImage = await getImage({ src: screenV3GallerySelected, width: 800 });

// Home and Catalog screenshots already bake in their own status bar /
// home indicator, so the overlay defaults to off for those (still
// toggleable manually); the other screens don't, so it defaults on.
const images = [
  {
    src: homeImage.src,
    alt: 'Unistellar app home screen',
    label: 'Home',
    defaultChrome: false,
  },
  {
    src: catalogImage.src,
    alt: 'Unistellar app catalog screen',
    label: 'Catalog',
    defaultChrome: false,
  },
  {
    src: observationV1Image.src,
    alt: 'Unistellar app observation screen, V1',
    label: 'Observation V1',
    defaultChrome: true,
  },
  {
    src: observationV2Image.src,
    alt: 'Unistellar app observation screen, V2',
    label: 'Observation V2',
    defaultChrome: true,
  },
  {
    src: v3HomeImage.src,
    alt: 'Unistellar app home screen, V3',
    label: 'Home V3',
    defaultChrome: true,
  },
  {
    src: v3GalleryPreviewImage.src,
    alt: 'Unistellar app gallery preview screen, V3',
    label: 'Gallery preview V3',
    defaultChrome: true,
  },
  {
    src: v3GallerySelectedImage.src,
    alt: 'Unistellar app gallery selection screen, V3',
    label: 'Gallery selected V3',
    defaultChrome: true,
  },
];
---

<Layout pageTitle="Components" lang={lang} class="max-w-7xl mx-auto p-6 pt-24">
  <h1 class="font-avara text-3xl text-gray-900 dark:text-gray-50 mb-8">
    Components
  </h1>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      PhoneMockup
    </h2>
    <PhoneMockupPreview images={images} client:load />
  </section>
</Layout>
