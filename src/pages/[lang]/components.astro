---
import Layout from '@layouts/Layout.astro';

import { getImage } from 'astro:assets';
import PhoneMockupPreview from '@components/PhoneMockupPreview.jsx';
import Card from '@components/Card.astro';

import { locales } from '@locales/config.json';
import { loadScreensOnce } from '@utils/useScreens';

import screenHome from '@assets/unistellar/screen-unistellar-home.png';
import screenCatalog from '@assets/unistellar/screen-unistellar-catalog.png';
import screenV1Observation from '@assets/unistellar/unistellar-screen-v1-observation.png';
import screenV2Observation from '@assets/unistellar/unistellar-screen-v2-observation.png';

export function getStaticPaths() {
  return locales.map((loc) => ({ params: { lang: loc } }));
}

const { lang } = Astro.params;

const homeImage = await getImage({ src: screenHome, width: 800 });
const catalogImage = await getImage({ src: screenCatalog, width: 800 });
const observationV1Image = await getImage({ src: screenV1Observation, width: 800 });
const observationV2Image = await getImage({ src: screenV2Observation, width: 800 });

// Every screen-unistellar-v* asset is auto-added to the picker below (push
// layout by default, since these captures don't bake in their own status
// bar), so new ones just need to land in src/assets/unistellar/.
const screens = import.meta.glob('../../assets/unistellar/*{jpg,png,gif,webp}');
const metadata = await import('../../assets/unistellar/images-metadata.json');
const allScreens = await loadScreensOnce(screens, metadata);
const v3Images = Object.values(allScreens)
  .filter((img) => img.name.startsWith('screen-unistellar-v'))
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((img) => ({
    src: img.src,
    alt: img.alt?.[lang] || img.name,
    label: img.name.replace('screen-unistellar-', ''),
    defaultOverlay: false,
  }));

// Home and Catalog screenshots already bake in their own status bar / home
// indicator, so our bars default to overlaying on top of the full
// screenshot instead of pushing (and duplicating) their own.
const images = [
  {
    src: homeImage.src,
    alt: 'Unistellar app home screen',
    label: 'Home',
    defaultOverlay: true,
  },
  {
    src: catalogImage.src,
    alt: 'Unistellar app catalog screen',
    label: 'Catalog',
    defaultOverlay: true,
  },
  {
    src: observationV1Image.src,
    alt: 'Unistellar app observation screen, V1',
    label: 'Observation V1',
    defaultOverlay: false,
  },
  {
    src: observationV2Image.src,
    alt: 'Unistellar app observation screen, V2',
    label: 'Observation V2',
    defaultOverlay: false,
  },
  ...v3Images,
];
---

<Layout pageTitle="Components" lang={lang} class="max-w-7xl mx-auto p-6 pt-24">
  <h1 class="font-avara text-3xl text-gray-900 dark:text-gray-50 mb-8">
    Components
  </h1>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      PhoneMockup
    </h2>
    <PhoneMockupPreview images={images} client:load />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      Card
    </h2>
    <div class="flex flex-row flex-wrap gap-4">
      <Card padding="4" class="w-64">
        <h3 class="text-lg font-bold dark:text-slate-100">Default, padding 4</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          style="default" (the fallback) — slate background, slate border.
        </p>
      </Card>

      <Card style="accent" padding="4" class="w-64">
        <h3 class="text-lg font-bold dark:text-slate-100">Accent, padding 4</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          style="accent" — blue background, blue border.
        </p>
      </Card>

      <Card padding="2" class="w-64">
        <h3 class="text-lg font-bold dark:text-slate-100">Default, padding 2</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Lower padding value for tighter layouts.
        </p>
      </Card>

      <Card style="accent" padding="2" class="w-64 flex-row items-center gap-3">
        <h3 class="text-lg font-bold dark:text-slate-100">Row</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          class overrides flex-col with flex-row.
        </p>
      </Card>
    </div>
  </section>
</Layout>
