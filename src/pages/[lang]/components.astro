---
import Layout from '@layouts/Layout.astro';

import { getImage } from 'astro:assets';
import PhoneMockupPreview from '@components/project/PhoneMockupPreview.jsx';
import CoverUnistellarUX from '@components/project/CoverUnistellarUX.astro';
import CoverUnistellar from '@components/project/CoverUnistellar.astro';
import InfoColumn from '@components/project/InfoColumn.astro';
import Metrics from '@components/project/Metrics.astro';
import Mosaic from '@components/project/Mosaic.astro';
import Verbatim from '@components/project/Verbatim.astro';
import UserJourneyStep from '@components/project/UserJourneyStep.astro';
import StepReveal from '@components/project/StepReveal.astro';
import InternalLink from '@components/project/InternalLink.astro';
import Quote from '@components/project/Quote.astro';
import TableOfContents from '@components/project/TableOfContents.astro';

import { locales } from '@locales/config.json';
import { loadScreensOnce } from '@utils/useScreens';

import screenHome from '@assets/unistellar/eVscope occulaire.png';
import screenCatalog from '@assets/unistellar/eVscope focus.png';
import screenV1Observation from '@assets/unistellar/observation nuit.png';
import screenV2Observation from '@assets/unistellar/horsehead.png';

export function getStaticPaths() {
  return locales.map((loc) => ({ params: { lang: loc } }));
}

const { lang } = Astro.params;

const homeImage = await getImage({ src: screenHome, width: 800 });
const catalogImage = await getImage({ src: screenCatalog, width: 800 });
const observationV1Image = await getImage({ src: screenV1Observation, width: 800 });
const observationV2Image = await getImage({ src: screenV2Observation, width: 800 });

// Every screen-unistellar-v* asset is auto-added to the picker below (push
// layout by default, since these captures don't bake in their own status
// bar), so new ones just need to land in src/assets/unistellar/.
const screens = import.meta.glob('../../assets/unistellar/*{jpg,png,gif,webp}');
const metadata = await import('../../assets/unistellar/images-metadata.json');
const allScreens = await loadScreensOnce(screens, metadata);
const v3Images = Object.values(allScreens)
  .filter((img) => img.name.startsWith('screen-unistellar-v'))
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((img) => ({
    src: img.src,
    alt: img.alt?.[lang] || img.name,
    label: img.name.replace('screen-unistellar-', ''),
    defaultOverlay: false,
  }));

// Only the screen-unistellar-v* captures are real app screens; the picker
// is restricted to those (no illustration/eVscope shots).
const images = v3Images;

const mosaicImages = Object.values(allScreens)
  .filter((img) => img.name.startsWith('screen-'))
  .slice(0, 8);
---

<Layout pageTitle="Components" lang={lang} class="max-w-7xl mx-auto p-6 pt-24">
  <h1 class="font-avara text-3xl text-gray-900 dark:text-gray-50 mb-8">
    Components
  </h1>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      PhoneMockup
    </h2>
    <PhoneMockupPreview images={images} client:load />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      CoverUnistellarUX
    </h2>
    <CoverUnistellarUX />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      CoverUnistellar
    </h2>
    <div class="max-w-2xl">
      <CoverUnistellar />
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      InfoColumn
    </h2>
    <div class="flex flex-row flex-wrap">
      <InfoColumn title="Rôles" items={['Design lead', 'UX', 'UI', 'Direction artistique']} />
      <InfoColumn title="Compétences" items={['Patterns mobiles', 'Design system', 'Motion design']} />
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      Metrics
    </h2>
    <Metrics
      items={[
        { value: '40+', label: 'Score NPS' },
        { value: '+80k', label: 'Utilisateurs' },
        { value: '4/5', label: 'Étoiles sur les stores' },
      ]}
    />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      Verbatim
    </h2>
    <div class="flex flex-row flex-wrap gap-4">
      <Verbatim
        tag="Guidage"
        stage="Enhanced vision"
        text="Donc là je peux faire la mise au point maintenant ?"
      />
      <Verbatim
        tag="Charge de travail"
        stage="Orientation"
        text="Alors démarrer l’observation. Oh my god, je suis paumé là !"
      />
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      UserJourneyStep
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <UserJourneyStep
        label="Connexion"
        title="Create Actions That Inspire and Engage"
        text="Some app actions fail to connect emotionally or offer practical value, creating unnecessary frustration and lowering user satisfaction."
      />
      <UserJourneyStep
        label="Guidage"
        title="Be a Guide for Users Through Their Discovery"
        text="When faced with an overwhelming number of objects to observe, users often feel confused and uncertain about where to begin."
      />
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      StepReveal
    </h2>
    <StepReveal
      items={[
        {
          label: 'Unboxing',
          title: 'La première impression compte',
          text: "L'utilisateur découvre le produit et forme sa première impression, c'est le moment qui pose le ton émotionnel de toute l'expérience.",
          image: homeImage.src,
        },
        {
          label: 'Setup',
          title: 'Chaque friction est un abandon possible',
          text: "L'utilisateur configure et active le produit, l'enjeu ici c'est de réduire la charge cognitive pour éviter l'abandon.",
          image: catalogImage.src,
        },
        {
          label: 'Observation',
          title: "Laisser place à l'émerveillement",
          text: "L'utilisateur est en interaction directe avec le ciel, c'est le cœur de la valeur du produit, l'expérience doit s'effacer pour laisser place à l'émerveillement.",
          image: observationV1Image.src,
        },
        {
          label: 'Shared',
          title: 'Le vécu devient contenu',
          text: "L'utilisateur transforme son expérience personnelle en contenu social, c'est le moment qui crée de la rétention et de la viralité.",
          image: observationV2Image.src,
        },
      ]}
    />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      InternalLink
    </h2>
    <div class="flex flex-row flex-wrap gap-4">
      <InternalLink
        title="Rendre Accessible l'Astronomie"
        subtitle="Unistellar"
        href={`/${lang}/unistellar`}
      />
      <InternalLink
        title="Réduire la Friction"
        subtitle="Unistellar UX"
        href={`/${lang}/unistellar-ux`}
      />
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      Quote
    </h2>
    <Quote
      class="max-w-xl"
      text="J'étais super motivé pour commencer, mais maintenant je me sens complètement perdu, je ne sais pas où aller ensuite."
    />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      TableOfContents
    </h2>
    <TableOfContents
      alwaysVisible
      activeId="toc-demo-b"
      items={[
        { id: 'toc-demo-a', label: 'Introduction' },
        { id: 'toc-demo-b', label: 'Le problème' },
        { id: 'toc-demo-c', label: 'La méthode' },
      ]}
    />
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">
      Mosaic
    </h2>
    <Mosaic images={mosaicImages} col={4} />
  </section>
</Layout>
